# Two connections on purpose.
# ADMIN_DSN  - owner role, used only to introspect the schema and to seed data.
# AGENT_DSN  - the read-only role the agent actually queries with. It physically
#              cannot write, so a validator bug is not a data-loss bug.
ADMIN_DSN=postgresql://analyst:analyst@localhost:5434/retail
AGENT_DSN=postgresql://agent_ro:agent_ro@localhost:5434/retail

# LLM backend: ollama (local, free) | anthropic | huggingface
LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# Guardrails
MAX_ROWS=500            # every query is rewritten to carry a LIMIT no larger than this
STATEMENT_TIMEOUT_MS=10000
MAX_REPAIR_ATTEMPTS=3   # how many times the agent may rewrite after a database error
